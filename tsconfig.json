{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "types": [
      "astro/client"
    ],
    "resolveJsonModule": true,
    "allowJs": true,
    "strictNullChecks": true
  },
  "include": [
    ".astro/types.d.ts",
    "**/*.ts",
    "**/*.astro"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}