---
import Base from '../../layouts/Base.astro';
import Checker from '../../components/Checker.astro';
import ChangeList from '../../components/ChangeList.astro';
import { getDataset } from '../../lib/server/data';
import { liveStatus, STATUS_LABEL, statusBadgeClass, formatWindow, ageMatrix, stalenessLabel, primaryAgeRule } from '../../lib/presentation';
import { addDays, formatDate, formatDeadline, formatRelative, subtractYears } from '../../lib/core/dates';
import { CATEGORY_LABELS, QUALIFICATION_LABELS } from '../../lib/core/types';

export function getStaticPaths() {
  return getDataset().exams.map((exam) => ({ params: { slug: exam.slug }, props: { exam } }));
}

const { exam } = Astro.props;
const ds = getDataset();
const status = liveStatus(exam);
const changes = ds.changes.filter((c) => c.examId === exam.id);
const stale = stalenessLabel(exam.freshness);
const isVerified = exam.maintenance === 'verified';
const docs = exam.live?.docs ?? [];
const site = Astro.site ?? new URL('https://examlens.pages.dev');

const primaryRule = primaryAgeRule(exam);
const generalMax = primaryRule?.maxAge?.general ?? null;
const reservedMax = primaryRule?.maxAge?.sc ?? null;
const earliestDob =
  primaryRule && generalMax !== null ? addDays(subtractYears(primaryRule.cutoff, generalMax), 1) : null;
const canApply = status === 'open' || status === 'upcoming';
const faqs = [];
if (primaryRule) {
  const m = ageMatrix(primaryRule);
  const g = m.find((r) => r.category === 'general');
  const sc = m.find((r) => r.category === 'sc');
  faqs.push({
    q: `What is the age limit for ${exam.shortName} (${exam.notificationNo})?`,
    a: `As on ${formatDate(primaryRule.cutoff)}, the minimum age is ${primaryRule.minAge}. The maximum is ${g?.max ?? 'not prescribed'} for the general category and ${sc?.max ?? g?.max ?? 'not prescribed'} for SC/SC(A)/ST. Persons with benchmark disability get up to ${primaryRule.concessions.pwd?.value ?? '—'}, ex-servicemen ${primaryRule.concessions.exServicemen?.value ?? '—'}, and destitute widows ${primaryRule.concessions.destituteWidow?.value ?? '—'}. Source: ${exam.boardName} Notification No. ${exam.notificationNo}.`,
  });
}
faqs.push({
  q: `When is the ${exam.shortName} exam?`,
  a: exam.dates.examDate
    ? `The exam date currently published is ${formatDate(exam.dates.examDate)}. ${exam.dates.examDateRaw && exam.dates.examDateRaw !== formatDate(exam.dates.examDate) ? `The official dashboard states: “${exam.dates.examDateRaw.replace(/\s+/g, ' ').trim()}”.` : ''} Applications run ${formatWindow(exam.dates.applyStart, exam.dates.applyEnd)}.`
    : `No exam date is published yet. Applications run ${formatWindow(exam.dates.applyStart, exam.dates.applyEnd)}.`,
});
faqs.push({
  q: `Can I apply for ${exam.shortName} with a ${QUALIFICATION_LABELS.degree.toLowerCase()}?`,
  a: exam.qualifications[0]
    ? `${exam.qualifications[0].summary}${exam.qualifications[0].fieldSpecific ? ' The exact subject of the degree matters for some posts — check the notification before paying the fee.' : ''}`
    : 'The qualification requirements for this notification have not been individually verified yet.',
});

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: `${exam.name} — eligibility, age limit and dates`,
    url: `${site}exams/${exam.slug}`,
    inLanguage: 'en-IN',
    dateModified: ds.generatedAt ?? undefined,
    isPartOf: { '@type': 'WebSite', name: 'ExamLens Tamil Nadu', url: site.toString() },
    about: {
      '@type': 'GovernmentService',
      name: exam.name,
      serviceOperator: { '@type': 'GovernmentOrganization', name: exam.boardName },
      areaServed: { '@type': 'AdministrativeArea', name: 'Tamil Nadu' },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Exams', item: `${site}exams` },
      { '@type': 'ListItem', position: 2, name: exam.shortName, item: `${site}exams/${exam.slug}` },
    ],
  },
];
---
<Base
  title={`${exam.shortName} ${exam.notificationNo} — age limit, dates & eligibility | ExamLens`}
  description={`${exam.name}. Age limit as on ${primaryRule ? formatDate(primaryRule.cutoff) : 'the cut-off'}, category relaxations, qualifications and every published date change — quoted from the official notification.`}
  jsonLd={jsonLd}
>
  <div class="wrap" style="padding-block:22px 8px">
    <nav class="crumbs tiny" aria-label="Breadcrumb">
      <a href="/exams">Exams</a> <span aria-hidden="true">/</span> <span>{exam.board}</span>
    </nav>

    <div class="exam-header">
      <div>
        <div class="exam-badges">
          <span class="badge badge-neutral badge-mono">{exam.notificationNo}</span>
          <span class={`badge ${statusBadgeClass(status)}`}>{STATUS_LABEL[status]}</span>
          {isVerified
            ? <span class="badge badge-ok">Rules verified against source</span>
            : <span class="badge badge-warn">Dates tracked only</span>}
          {exam.citationIssues.length > 0 && <span class="badge badge-bad">Source text changed — under review</span>}
        </div>
        <h1>{exam.shortName}</h1>
        {exam.tamilName && <p class="tamil-name" lang="ta">{exam.tamilName}</p>}
        <p class="lede" style="margin-bottom:6px">{exam.summary}</p>
        <p class="small muted">{exam.boardName} · Notification No. {exam.notificationNo} · {exam.year}</p>
      </div>

      <aside class="exam-cta">
        {exam.dates.applyStart && (
          <div class="cta-block">
            <span class="tiny muted">Applications</span>
            <strong>{formatWindow(exam.dates.applyStart, exam.dates.applyEnd)}</strong>
            {exam.dates.applyEnd && exam.applyEndInDays !== null && exam.applyEndInDays >= 0 && (
              <span class="badge badge-warn" data-countdown={`${exam.dates.applyEnd}T23:59:59+05:30`}>
                {exam.applyEndInDays}d left
              </span>
            )}
          </div>
        )}
        {exam.dates.examDate && (
          <div class="cta-block">
            <span class="tiny muted">Exam date</span>
            <strong>{formatDate(exam.dates.examDate)}</strong>
          </div>
        )}
        <div class="cta-actions">
          {exam.officialLinks.apply && canApply && (
            <a class="btn btn-accent" href={exam.officialLinks.apply} target="_blank" rel="noopener">Apply on the official portal</a>
          )}
          {exam.officialLinks.apply && !canApply && (
            <a class="btn btn-sm" href={exam.officialLinks.apply} target="_blank" rel="noopener">Official portal (applications closed)</a>
          )}
          <a class="btn" href={exam.officialLinks.notification} target="_blank" rel="noopener">Notification PDF</a>
          <a class="btn btn-sm" href="/calendar.ics">Add deadlines to calendar</a>
        </div>
      </aside>
    </div>
  </div>

  {primaryRule && (
    <div class="wrap">
      <div class="answer-box">
        <div class="answer-main">
          <span class="answer-label">Age limit, as on {formatDate(primaryRule.cutoff)}</span>
          <p class="answer-value">
            {primaryRule.minAge} to {generalMax ?? 'no limit'} for the general category
            {reservedMax !== null && reservedMax !== generalMax ? `; ${reservedMax} for SC, SC(A), ST, MBC/DC and BC` : ''}.
          </p>
          {earliestDob && (
            <p class="small muted" style="margin:4px 0 0">
              To be under the general ceiling of {generalMax}, the date of birth must be on or after
              <strong>{formatDate(earliestDob)}</strong>. The limit applies to the rounding of completed years,
              so a birthday falling on the cut-off date itself is outside it.
            </p>
          )}
        </div>
        <a class="btn btn-sm" href="#check">Check your own date of birth</a>
      </div>
    </div>
  )}

  {exam.citationIssues.length > 0 && (
    <div class="wrap">
      <div class="callout" role="status">
        <strong>This record needs review.</strong> {exam.citationIssues.length} quoted sentence(s) could no longer be found in the official PDF,
        which usually means the Commission re-issued it. Read the notification before relying on the numbers below.
        <a href={exam.officialLinks.notification} target="_blank" rel="noopener">Open the source document</a>
      </div>
    </div>
  )}

  <div class="wrap exam-body">
    <div class="exam-main">
      {isVerified ? (
        <section id="check" class="panel">
          <h2>Can you apply?</h2>
          <p class="small muted" style="margin-top:-4px">
            {primaryRule
              ? `Checked against this notification's own cut-off date (${formatDate(primaryRule.cutoff)}).`
              : 'This notification prescribes no age limit; the conditions below decide eligibility.'}
          </p>
          <Checker only={exam.id} compact={true} />
        </section>
      ) : (
        <div class="callout" style="margin-bottom:20px">
          <strong>Eligibility rules not yet verified for this notification.</strong> Dates and documents below are mirrored
          live from the board dashboard, but ExamLens will not guess an age limit. Use the official notification.
        </div>
      )}

      {exam.hasAgeLimit === false && (
        <section class="panel" id="age-none">
          <h2>Age limit</h2>
          <p>
            The notification prescribes <strong>no minimum or maximum age</strong> for this test.
            Eligibility depends on the conditions listed below instead.
          </p>
          <p class="small muted">
            Age appears in the document only as the pedagogical age group of the pupils (6 to 11 and
            11 to 14 years) and as a field in the service certificate annexure.
          </p>
        </section>
      )}

      {exam.ageRules.map((rule) => {
        const rows = ageMatrix(rule);
        return (
          <section class="panel" id={`age-${rule.id}`}>
            <div class="section-head" style="margin-bottom:8px">
              <h2>Age limit — {rule.label}</h2>
            </div>
            <p class="small">
              Calculated <strong>as on {formatDate(rule.cutoff)}</strong>. A candidate must have completed
              {rule.minAge === 1 ? ' 1 year' : ` ${rule.minAge} years`} by that date, and must <em>not</em> have
              completed the maximum shown for their community.
              {rule.appliesTo.postNames.length > 0 && <> Applies to: {rule.appliesTo.postNames.join(', ')}.</>}
            </p>
            <div class="table-wrap">
              <table class="stack">
                <caption class="visually-hidden">Maximum age by community category for {rule.label}</caption>
                <thead>
                  <tr>
                    <th>Community</th>
                    <th class="num">Minimum</th>
                    <th class="num">Maximum</th>
                    <th class="num">PwBD</th>
                    <th class="num">Ex-servicemen</th>
                    <th class="num">Destitute widow</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((r) => (
                    <tr class={r.category === 'general' ? 'row-general' : ''}>
                      <th scope="row" style="text-transform:none;letter-spacing:0;font-size:0.86rem;background:transparent">{r.label}</th>
                      <td class="num" data-label="Minimum">{r.min ?? '—'}</td>
                      <td class="num" data-label="Maximum"><strong>{r.max ?? 'No limit'}</strong></td>
                      <td class="num" data-label="PwBD">{r.pwd ?? '—'}</td>
                      <td class="num" data-label="Ex-servicemen">{r.exsm ?? '—'}</td>
                      <td class="num" data-label="Destitute widow">{r.widow ?? '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="tiny muted" style="margin-top:8px">
              The PwBD, ex-servicemen and destitute-widow columns are absolute ceilings printed in the
              notification, not years added to the community limit. A community ceiling can only be claimed
              with a valid Tamil Nadu community certificate.
            </p>
            {rule.notes && <p class="small muted" style="margin-top:8px">{rule.notes}</p>}
            <blockquote class="quote">
              “{rule.citation.quote}”
              <cite>
                — <a href={exam.officialLinks.notification} target="_blank" rel="noopener">Notification {exam.notificationNo}</a>
                {rule.citation.page ? `, page ${rule.citation.page}` : ''}
                {rule.citation.values.length ? ` · table values ${rule.citation.values.join(', ')} re-checked` : ''}
              </cite>
            </blockquote>
          </section>
        );
      })}

      {exam.qualifications.length > 0 && (
        <section class="panel" id="qualifications">
          <h2>Educational qualification</h2>
          <ul class="qual-list">
            {exam.qualifications.map((q) => (
              <li>
                <p style="margin-bottom:6px">{q.summary}</p>
                {q.postNames.length > 0 && <p class="tiny muted">Posts: {q.postNames.join(', ')}</p>}
                {q.fieldSpecific && (
                  <p class="small"><span class="badge badge-warn">Subject matters</span> The degree must be in a specified discipline — check before applying.</p>
                )}
                <blockquote class="quote">
                  “{q.citation.quote}”
                  <cite>— page {q.citation.page ?? '—'}</cite>
                </blockquote>
              </li>
            ))}
          </ul>
        </section>
      )}

      {exam.specialRequirements.length > 0 && (
        <section class="panel" id="requirements">
          <h2>Other conditions</h2>
          <ul class="req-list">
            {exam.specialRequirements.map((r) => (
              <li>
                <strong>{r.label}</strong>
                <p class="small" style="margin:2px 0 0">{r.detail}</p>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section class="panel" id="dates">
        <h2>Dates & documents</h2>
        <dl class="kv">
          <dt>Notification</dt><dd>{exam.dates.notification ? formatDate(exam.dates.notification) : '—'}</dd>
          <dt>Applications</dt><dd>{formatWindow(exam.dates.applyStart, exam.dates.applyEnd)}</dd>
          <dt>Exam</dt><dd>{exam.dates.examDate ? formatDate(exam.dates.examDate) : 'Not announced'}</dd>
          <dt>Age cut-off</dt><dd>{exam.dates.cutoffAgeDate ? formatDate(exam.dates.cutoffAgeDate) : '—'}</dd>
          <dt>Fee</dt><dd>{exam.fee.amount !== null ? `₹${exam.fee.amount}` : 'See notification'} {exam.fee.note && <span class="muted small">· {exam.fee.note}</span>}</dd>
        </dl>

        {docs.length > 0 && (
          <>
            <h3 style="margin-top:22px">Everything published for this exam</h3>
            <p class="tiny muted">Mirrored from the board dashboard, newest first. Upload dates are the Commission’s.</p>
            <ol class="doc-list">
              {docs.map((d) => (
                <li>
                  <span class="doc-date num">{d.uploadedAt ? formatDate(d.uploadedAt) : '—'}</span>
                  <span class="doc-cat badge badge-neutral tiny">{d.category}</span>
                  {d.url
                    ? <a href={d.url} target="_blank" rel="noopener">{d.title}</a>
                    : <span class="muted">{d.title}</span>}
                </li>
              ))}
            </ol>
          </>
        )}
      </section>

      <section class="panel" id="changes">
        <div class="section-head" style="margin-bottom:12px">
          <h2>Change history</h2>
          <a class="small" href="/changes">All exams</a>
        </div>
        <ChangeList changes={changes} showExam={false} emptyText="No changes recorded for this exam since tracking began." />
      </section>

      <section class="panel" id="questions">
        <h2>Common questions</h2>
        {faqs.map((f) => (
          <details class="disclosure" style="margin-bottom:8px">
            <summary>{f.q}</summary>
            <p class="small" style="margin:0;color:var(--ink-2)">{f.a}</p>
          </details>
        ))}
      </section>

      <section class="panel" id="sources">
        <h2>Sources & verification</h2>
        <ul class="source-list">
          {exam.sources.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener">{s.title}</a>
              <span class="tiny muted">{s.authority}{s.locator ? ` · ${s.locator}` : ''}</span>
            </li>
          ))}
          <li>
            <a href={exam.live?.sourceUrl ?? 'https://tnpsc.gov.in/'} target="_blank" rel="noopener">Board exam dashboard</a>
            <span class="tiny muted">Live dates and document list</span>
          </li>
        </ul>
        <div class="verify-box">
          <span class={`badge ${stale.tone === 'ok' ? 'badge-ok' : stale.tone === 'warn' ? 'badge-warn' : 'badge-neutral'}`}>{stale.text}</span>
          <p class="tiny muted" style="margin:6px 0 0">
            {exam.freshness.verifiedAt
              ? <>Last successful source check <span data-rel={exam.freshness.verifiedAt}>{formatRelative(exam.freshness.verifiedAt)}</span>. </>
              : 'Not yet checked against the source. '}
            Each citation quote is searched for in the freshly downloaded PDF; a mismatch hides the verdict behind a warning.
          </p>
        </div>
      </section>
    </div>

    <aside class="exam-aside">
      <div class="card card-flat aside-card">
        <h3 style="font-size:0.95rem">At a glance</h3>
        <dl class="kv" style="grid-template-columns:1fr;gap:10px">
          <div><dt>Vacancies</dt><dd>{exam.vacancies.total !== null ? exam.vacancies.total.toLocaleString('en-IN') : 'See notification'}</dd></div>
          <div><dt>Selection</dt><dd>{exam.selectionProcess.length ? exam.selectionProcess.join(', then ') : '—'}</dd></div>
          <div><dt>Level</dt><dd style="text-transform:capitalize">{exam.level.replace('-', ' ')}</dd></div>
          <div><dt>Tracked</dt><dd>{isVerified ? 'Rules + dates' : 'Dates only'}</dd></div>
        </dl>
      </div>
      <div class="card card-flat aside-card">
        <h3 style="font-size:0.95rem">Share this answer</h3>
        <p class="tiny muted">The link carries the notification number and the date we last checked it.</p>
        <div style="display:grid;gap:6px">
          <a class="btn btn-sm" href={isVerified ? `/exams/${exam.slug}/check` : '/check'}>
            {isVerified ? 'Open eligibility checker' : 'Check another exam'}
          </a>
          <a class="btn btn-sm" href={`/api/v1/exam/${exam.id}.json`}>Machine-readable JSON</a>
          <button class="btn btn-sm js-print" type="button">Print / save as PDF</button>
        </div>
      </div>
      <div class="card card-flat aside-card">
        <h3 style="font-size:0.95rem">Disclaimer</h3>
        <p class="tiny muted" style="margin:0">
          Reproduced for information. The official notification prevails. ExamLens is independent and not affiliated with any board.
        </p>
      </div>
    </aside>
  </div>
</Base>

<script>
  document.querySelector('.js-print')?.addEventListener('click', () => window.print());
</script>

<style>
  .answer-box {
    display: flex; justify-content: space-between; align-items: center; gap: 18px;
    border: 1px solid var(--ink); border-left-width: 4px; padding: 12px 16px;
    margin-top: 4px; flex-wrap: wrap;
  }
  .answer-label { font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  .answer-value { font-size: 1.05rem; margin: 2px 0 0; font-weight: 600; }
  .crumbs { display: flex; gap: 6px; color: var(--muted); margin-bottom: 14px; }
  .crumbs a { color: var(--muted); }
  .exam-header { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: 32px; align-items: start; }
  @media (max-width: 900px) { .exam-header { grid-template-columns: 1fr; } }
  .exam-badges { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
  .exam-header h1 { margin-bottom: 6px; }
  .tamil-name { font-size: 1.05rem; color: var(--ink-2); margin: -2px 0 10px; }
  .exam-cta {
    background: #fff; border: 1px solid var(--rule);
    padding: 14px; display: grid; gap: 10px;
  }
  .cta-block { display: grid; gap: 1px; }
  .cta-block strong { font-size: 0.95rem; }
  .cta-actions { display: grid; gap: 7px; }
  .exam-body { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 32px; padding-block: 26px 50px; align-items: start; }
  @media (max-width: 980px) { .exam-body { grid-template-columns: 1fr; } .exam-aside { order: -1; display: grid; grid-template-columns: repeat(auto-fit,minmax(220px,1fr)); gap: 12px; } }
  .panel { border: 0; border-top: 1px solid var(--rule); padding: 18px 0 0; margin-bottom: 24px; }
  .panel h2 { font-size: 1.3rem; margin-bottom: 10px; }
  .exam-aside { display: grid; gap: 12px; }
  .aside-card h3 { margin-bottom: 8px; }
  .row-general th { background: var(--panel) !important; }
  blockquote.quote {
    margin: 14px 0 0; padding: 10px 14px; border-left: 3px solid var(--link);
    background: var(--panel);
    font-size: 0.82rem; color: var(--ink-2); line-height: 1.5;
  }
  blockquote.quote cite { display: block; margin-top: 6px; font-style: normal; font-size: 0.74rem; color: var(--muted); }
  .qual-list, .req-list, .source-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .qual-list > li, .req-list > li { padding-left: 14px; border-left: 2px solid var(--rule); }
  .doc-list { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 7px; font-size: 0.86rem; }
  .doc-list li { display: grid; grid-template-columns: 88px auto 1fr; gap: 8px; align-items: baseline; }
  @media (max-width: 560px) { .doc-list li { grid-template-columns: 1fr; gap: 2px; } }
  .doc-date { color: var(--muted); font-size: 0.76rem; }
  .doc-cat { justify-self: start; }
  .source-list li { display: grid; gap: 1px; }
  .verify-box { margin-top: 14px; padding-top: 14px; border-top: 1px dashed var(--rule); }
</style>
